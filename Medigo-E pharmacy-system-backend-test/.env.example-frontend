# Frontend Environment Variables
# Create .env file in your React app root directory

# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api

# For production:
# VITE_API_BASE_URL=https://api.medigo.com/api

# App Configuration
VITE_APP_NAME=Medigo E-Pharmacy
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_OCR=true
VITE_OCR_TIMEOUT=150000  # 2.5 minutes in milliseconds

# Cloudinary (if needed for client-side uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_api_key
